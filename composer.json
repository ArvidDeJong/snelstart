{
    "name": "darvis/snelstart",
    "description": "PHP client for the SnelStart B2B API v2 (Dutch accounting software): token handling, every collection with paging, and a Laravel integration with facade, encrypted token cache and Http::fake() support.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://arviddejong.github.io/snelstart/",
    "keywords": [
        "php",
        "laravel",
        "snelstart",
        "accounting",
        "bookkeeping",
        "boekhouden",
        "b2b-api",
        "api-client",
        "invoicing",
        "laravel-boost"
    ],
    "authors": [
        {
            "name": "Arvid de Jong",
            "email": "info@arvid.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/ArvidDeJong/snelstart/issues",
        "source": "https://github.com/ArvidDeJong/snelstart",
        "docs": "https://arviddejong.github.io/snelstart/"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "ext-curl": "*",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "conflict": {
        "illuminate/support": "<11.0"
    },
    "suggest": {
        "ext-curl": "Required by the default transport, for projects without Laravel.",
        "laravel/framework": "Enables the service provider, the facade, the encrypted token cache and Http::fake() support (Laravel 11, 12 or 13)."
    },
    "autoload": {
        "psr-4": {
            "Darvis\\Snelstart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darvis\\Snelstart\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest tests",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "aliases": {
                "Snelstart": "Darvis\\Snelstart\\Laravel\\Facades\\Snelstart"
            },
            "providers": [
                "Darvis\\Snelstart\\Laravel\\SnelstartServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
